{
  "manifest_version": 3,
  "name": "Roblox Checkers Gate",
  "version": "1.9.1",
  "description": "Win checkers to join Roblox places. Languages, badges, adaptive difficulty.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.roblox.com/*",
    "https://web.roblox.com/*",
    "https://*.workers.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/home*",
        "https://www.roblox.com/*/home*",
        "https://www.roblox.com/friends*",
        "https://www.roblox.com/*/friends*",
        "https://www.roblox.com/users/*/profile*",
        "https://www.roblox.com/*/users/*/profile*",
        "https://www.roblox.com/users/*/friends*",
        "https://www.roblox.com/discover*",
        "https://www.roblox.com/*/discover*",
        "https://www.roblox.com/charts*",
        "https://www.roblox.com/*/charts*",
        "https://www.roblox.com/games/*",
        "https://www.roblox.com/*/games/*",
        "https://web.roblox.com/home*",
        "https://web.roblox.com/*/home*",
        "https://web.roblox.com/friends*",
        "https://web.roblox.com/*/friends*",
        "https://web.roblox.com/users/*/profile*",
        "https://web.roblox.com/*/users/*/profile*",
        "https://web.roblox.com/users/*/friends*",
        "https://web.roblox.com/discover*",
        "https://web.roblox.com/*/discover*",
        "https://web.roblox.com/charts*",
        "https://web.roblox.com/*/charts*",
        "https://web.roblox.com/games/*",
        "https://web.roblox.com/*/games/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.roblox.com/users/*/profile*",
        "https://web.roblox.com/users/*/profile*"
      ],
      "js": [
        "badge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "checkers.html",
        "checkers.js",
        "style.css"
      ],
      "matches": [
        "https://www.roblox.com/*",
        "https://web.roblox.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Roblox Checkers Gate",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}